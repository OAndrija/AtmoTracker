<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.SensorsFragment">

    <androidx.cardview.widget.CardView
        android:id="@+id/hintWeatherCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="5dp"
        android:elevation="5dp"
        android:backgroundTint="@color/md_theme_tertiary"
        android:padding="12dp"
        app:cardCornerRadius="13dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/hintWeatherText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_hint"
            app:drawableTint="@color/md_theme_onTertiary"
            android:gravity="center_vertical"
            android:text="Choose one of the marked Weather Stations"
            android:textColor="@color/md_theme_onTertiary"
            android:textSize="13sp"
            android:padding="4sp"
            android:textStyle="bold" />
    </androidx.cardview.widget.CardView>

    <org.osmdroid.views.MapView
        android:id="@+id/osm_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </org.osmdroid.views.MapView>

    <Button
        android:id="@+id/chooseMarkedWeatherButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/button_side_margin"
        android:layout_marginEnd="@dimen/button_side_margin"
        android:layout_marginBottom="10dp"
        android:background="@drawable/button_style_primary"
        android:padding="@dimen/button_padding"
        android:text="Choose Marked Location"
        android:textColor="@color/md_theme_onTertiary"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:icon="@drawable/ic_marked"
        app:iconTint="@color/md_theme_onTertiary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>