<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible"
    android:background="@color/md_theme_background"
    tools:context=".fragments.InputFragment">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="180dp"
        android:layout_marginEnd="15dp"
        android:backgroundTint="@color/md_theme_surfaceContainer"
        android:padding="20dp"
        app:cardCornerRadius="30dp"
        app:layout_constraintBottom_toTopOf="@+id/addButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/horizontalGuideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="152dp" />

            <TextView
                android:id="@+id/stepCountLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="20dp"
                android:padding="15dp"
                android:text="Temperature:"
                android:textAlignment="viewStart"
                android:textColor="@color/md_theme_primary"
                android:textSize="@dimen/label_font_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/caloriesSpentLabel"
                app:layout_constraintEnd_toStartOf="@+id/horizontalGuideline"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/stepCountInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="15dp"
                android:backgroundTint="@color/md_theme_onSurfaceVariant"
                android:ems="15"
                android:hint="@string/step_hint"
                android:inputType="text"
                android:padding="15dp"
                android:textColor="@color/md_theme_onSurface"
                android:textColorHint="@color/md_theme_outline"
                android:textSize="@dimen/input_font_size"
                app:layout_constraintBottom_toBottomOf="@+id/stepCountLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="@+id/horizontalGuideline"
                app:layout_constraintTop_toTopOf="@+id/stepCountLabel" />

            <TextView
                android:id="@+id/caloriesSpentLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:padding="15dp"
                android:text="@string/calories_label"
                android:textColor="@color/md_theme_primary"
                android:textSize="@dimen/label_font_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/dateLabel"
                app:layout_constraintEnd_toStartOf="@+id/horizontalGuideline"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/stepCountLabel" />

            <EditText
                android:id="@+id/caloriesSpentInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="15dp"
                android:backgroundTint="@color/md_theme_onSurfaceVariant"
                android:ellipsize="end"
                android:ems="15"
                android:hint="@string/calories_hint"
                android:inputType="text"
                android:padding="15dp"
                android:textColor="@color/md_theme_onSurface"
                android:textColorHint="@color/md_theme_outline"
                android:textSize="@dimen/input_font_size"
                app:layout_constraintBottom_toBottomOf="@+id/caloriesSpentLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="@+id/horizontalGuideline"
                app:layout_constraintTop_toTopOf="@+id/caloriesSpentLabel" />

            <TextView
                android:id="@+id/dateLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:padding="15dp"
                android:text="@string/date_label"
                android:textColor="@color/md_theme_primary"
                android:textSize="@dimen/label_font_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/timeSpentLabel"
                app:layout_constraintEnd_toStartOf="@+id/horizontalGuideline"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/caloriesSpentLabel" />

            <EditText
                android:id="@+id/dateInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="15dp"
                android:backgroundTint="@color/md_theme_onSurfaceVariant"
                android:ems="5"
                android:hint="@string/date_hint"
                android:inputType="date"
                android:padding="15dp"
                android:textColor="@color/md_theme_onSurface"
                android:textColorHint="@color/md_theme_outline"
                android:textSize="@dimen/input_font_size"
                app:layout_constraintBottom_toBottomOf="@+id/dateLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="@+id/horizontalGuideline"
                app:layout_constraintTop_toTopOf="@+id/dateLabel" />

            <TextView
                android:id="@+id/timeSpentLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:padding="15dp"
                android:text="@string/time_label"
                android:textColor="@color/md_theme_primary"
                android:textSize="@dimen/label_font_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/horizontalGuideline"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dateLabel" />

            <EditText
                android:id="@+id/timeSpentInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="15dp"
                android:backgroundTint="@color/md_theme_onSurfaceVariant"
                android:ems="10"
                android:hint="@string/time_hint"
                android:inputType="number|numberDecimal"
                android:padding="15dp"
                android:textColor="@color/md_theme_onSurface"
                android:textColorHint="@color/md_theme_outline"
                android:textSize="@dimen/input_font_size"
                app:layout_constraintBottom_toBottomOf="@+id/timeSpentLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="@+id/horizontalGuideline"
                app:layout_constraintTop_toTopOf="@+id/timeSpentLabel" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/addWalkButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/button_side_margin"
        android:layout_marginEnd="@dimen/button_side_margin"
        android:background="@drawable/button_style_primary"
        android:padding="@dimen/button_padding"
        android:text="Add weather"
        android:textColor="@color/md_theme_onTertiary"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="@color/md_theme_onTertiary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardView" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="113dp"
        android:layout_height="129dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="-10dp"
        android:src="@drawable/ic_tree"
        app:layout_constraintBottom_toTopOf="@+id/cardView"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="88dp"
        android:layout_height="107dp"
        android:layout_marginBottom="-10dp"
        android:src="@drawable/ic_person"
        app:layout_constraintBottom_toTopOf="@+id/cardView"
        app:layout_constraintStart_toEndOf="@+id/imageView" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="79dp"
        android:layout_height="53dp"
        android:src="@drawable/ic_bench"
        app:layout_constraintBottom_toTopOf="@+id/cardView"
        app:layout_constraintStart_toEndOf="@+id/imageView2" />

    <ImageView
        android:id="@+id/imageView4"
        android:layout_width="126dp"
        android:layout_height="125dp"
        android:src="@drawable/ic_tree"
        app:layout_constraintBottom_toTopOf="@+id/cardView"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>